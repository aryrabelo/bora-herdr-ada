/target
/prebuilt/
node_modules/
/vendor/libghostty-vt/zig-pkg/
__pycache__/
*.pyc
*.swp
*.swo
*~
.DS_Store

/docs/*
!/docs/next/
!/docs/next/**
!/docs/preview/
!/docs/preview/**
!/docs/versions/
!/docs/versions/**
/.local/
/backlog

/.pi/todos
/.pi/issues
/.pi/cache
/result
/result-*

/.wrangler/
**/.wrangler/

# graphify generated output
graphify-out/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Per-worktree direnv file written by ppws create; never committed.
# Anchored to the repo root on purpose: a bare `.envrc` would also cover the
# tracked vendor/libghostty-vt/.envrc if re-vendoring ever untracks it.
/.envrc

# Stale lock left behind when a bd invocation is interrupted.
.beads.gate.lock

# Local usina dispatch/scope artifacts (per-worktree agent bookkeeping)
/.usina-*
# Per-pane north/scratch notes written by `north-note`. They are session
# artifacts of whoever happens to be driving a pane, never repo content —
# and without this entry a `git add -A` stages them, which is how
# `foninholandia` ended up with them TRACKED (measured 2026-09-07).
# Ignoring only stops that recurring; anything already tracked still needs
# `git rm --cached`, as the commit beside this one does.
/scratch/
