/target
/prebuilt/
node_modules/
/vendor/libghostty-vt/zig-pkg/
__pycache__/
*.pyc
*.swp
*.swo
*~
.DS_Store

/docs/*
!/docs/next/
!/docs/next/**
!/docs/preview/
!/docs/preview/**
!/docs/versions/
!/docs/versions/**
/.local/
/backlog

/.pi/todos
/.pi/issues
/.pi/cache
/result
/result-*

/.wrangler/
**/.wrangler/

# graphify generated output
graphify-out/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Per-worktree direnv file written by ppws create; never committed.
# Anchored to the repo root on purpose: a bare `.envrc` would also cover the
# tracked vendor/libghostty-vt/.envrc if re-vendoring ever untracks it.
/.envrc

# Stale lock left behind when a bd invocation is interrupted.
.beads.gate.lock

# Per-pane north/scratch notes written by `north-note`. They are session
# artifacts of whoever happens to be driving a pane, never repo content —
# and without this entry they show up as untracked noise in every
# `git status` (measured 2026-09-07: `foninholandia` has them TRACKED for
# lack of this line).
/scratch/
